<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0"
      style="-fx-background-color: #f5f5f5; -fx-font-family: 'Roboto';"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.JugadorController">

    <Label fx:id="titleLabel" text="Guess My Rule"
   style="-fx-font-family: 'SIXTY'; -fx-font-size: 74px; -fx-text-fill: #616161;"/>

<Label fx:id="feedbackLabel" text=""
   style="-fx-font-family: Roboto; -fx-font-size: 13px; -fx-text-fill: #4caf50;"/>

    <TextField fx:id="aliasField"
        promptText="Ingrese su alias"
        prefWidth="200" maxWidth="250"
        style="-fx-background-radius: 8; -fx-padding: 8; -fx-font-size: 14px;
               -fx-border-color: #64b5f6; -fx-border-radius: 8; -fx-border-width: 2;"/>

    <Button fx:id="btnRegistrar" text="Registrar" onAction="#handleRegistrar"
        style="-fx-background-color: #f5f5f5; -fx-text-fill: black; -fx-font-size: 14px;
               -fx-padding: 8 20 8 20; -fx-background-radius: 8; -fx-cursor: hand;"/>

    <Button fx:id="btnInvitado" text="Ingresar como Invitado" onAction="#handleInvitado"
        style="-fx-background-color: #8fc4f0; -fx-text-fill: white; -fx-font-size: 14px;
               -fx-padding: 8 20 8 20; -fx-background-radius: 8; -fx-cursor: hand;"/>

    <Button fx:id="btnStart" text="Start" disable="true" onAction="#handleStart"
        style="-fx-background-color: #76fc69; -fx-text-fill: white; -fx-font-size: 14px;
               -fx-padding: 10 30 10 30; -fx-background-radius: 8; -fx-cursor: hand;"/>

</VBox>

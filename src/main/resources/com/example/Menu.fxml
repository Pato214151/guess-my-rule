<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.MenuController"
            style="-fx-background-color: #f5f5f5; -fx-font-family: Roboto;">

    <top>
        <HBox style="-fx-padding: 15; -fx-background-color: #e3f2fd;">
            <Label fx:id="welcomeLabel" text="Bienvenido, Jugador"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1565c0;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15">
            <padding>
                <Insets top="30" bottom="30" left="30" right="30"/>
            </padding>

            <Label text="Selecciona un Nivel"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #424242;"/>

            <Button text="Nivel 1" onAction="#handleNivel"
                    prefWidth="200" prefHeight="55"
                    style="-fx-background-color: #64b5f6; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 10; -fx-cursor: hand;"
                    onMouseEntered="#handleHoverOn" onMouseExited="#handleHoverOff"/>
            <Button text="Nivel 2" onAction="#handleNivel"
                    prefWidth="200" prefHeight="55"
                    style="-fx-background-color: #64b5f6; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 10; -fx-cursor: hand;"
                    onMouseEntered="#handleHoverOn" onMouseExited="#handleHoverOff"/>
            <Button text="Nivel 3" onAction="#handleNivel"
                    prefWidth="200" prefHeight="55"
                    style="-fx-background-color: #64b5f6; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 10; -fx-cursor: hand;"
                    onMouseEntered="#handleHoverOn" onMouseExited="#handleHoverOff"/>
            <Button text="Nivel 4" onAction="#handleNivel"
                    prefWidth="200" prefHeight="55"
                    style="-fx-background-color: #64b5f6; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 10; -fx-cursor: hand;"
                    onMouseEntered="#handleHoverOn" onMouseExited="#handleHoverOff"/>
            <Button text="Nivel 5" onAction="#handleNivel"
                    prefWidth="200" prefHeight="55"
                    style="-fx-background-color: #64b5f6; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 10; -fx-cursor: hand;"
                    onMouseEntered="#handleHoverOn" onMouseExited="#handleHoverOff"/>
            <Button text="Nivel 6" onAction="#handleNivel"
                    prefWidth="200" prefHeight="55"
                    style="-fx-background-color: #64b5f6; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 10; -fx-cursor: hand;"
                    onMouseEntered="#handleHoverOn" onMouseExited="#handleHoverOff"/>
            <Label text="¿Cómo Jugar?" onMouseClicked="#handleComoJugar"
       onMouseEntered="#handleHoverOn" onMouseExited="#handleHoverOff"
       style="-fx-font-size: 14px; -fx-text-fill: #ffb74d; -fx-cursor: hand; -fx-underline: true;"/>
        </VBox>
    </center>

</BorderPane>
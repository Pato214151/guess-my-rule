<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0"
      style="-fx-background-color: #f5f5f5;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.PrimaryController">

    <Label text="Guess My Rule"
           style="-fx-font-size: 64px;
                  -fx-text-fill: #333333;">
        <font>
            <Font url="@fonts/Montserrat-Bold.ttf" size="64"/>
        </font>
    </Label>

    <TextField fx:id="aliasField"
        promptText="Ingrese su alias"
        prefWidth="200"
        maxWidth="250"
        style="-fx-background-radius: 8;
               -fx-padding: 8;
               -fx-font-size: 14px;
               -fx-border-color: #64b5f6;
               -fx-border-radius: 8;
               -fx-border-width: 2;" />

    <Button fx:id="btnRegistrar"
        text="Registrar"
        onAction="#handleRegistrar"
        style="-fx-background-color: #f5f5f5;
        -fx-text-fill: black;
        -fx-font-size: 14px;
        -fx-padding: 8 20 8 20;
        -fx-background-radius: 8;
        -fx-cursor: hand;">
    <font>
        <Font url="@fonts/Roboto-Regular.ttf" size="14"/>
    </font>
    </Button>

    <Button fx:id="btnInvitado"
        text="Ingresar como Invitado"
        onAction="#handleInvitado"
        style="-fx-background-color: #8fc4f0;
        -fx-text-fill: white;
        -fx-font-size: 14px;
        -fx-padding: 8 20 8 20;
        -fx-background-radius: 8;
        -fx-cursor: hand;">
    <font>
        <Font url="@fonts/Roboto-Regular.ttf" size="14"/>
    </font>
    </Button>

    <Button fx:id="btnStart"
        text="Start"
        disable="true"
        onAction="#handleStart"
        style="-fx-background-color: #76fc69;
               -fx-text-fill: white;
               -fx-font-size: 14px;
               -fx-padding: 10 30 10 30;
               -fx-background-radius: 8;
               -fx-cursor: hand;">

    <font>
        <Font url="@fonts/Roboto-Regular.ttf" size="16"/>
    </font>
    </Button>


</VBox>
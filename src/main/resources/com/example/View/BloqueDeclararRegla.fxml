<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.shape.Ellipse?>
<?import javafx.scene.effect.GaussianBlur?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.Controller.BloqueDeclararRegla">

    <!-- FONDO: elipses -->
    <Pane style="-fx-background-color: #d6d2d0;">
        <Ellipse centerX="350" centerY="100" radiusX="300" radiusY="300"
                 fill="#092483" opacity="1.0">
            <effect><GaussianBlur radius="500"/></effect>
        </Ellipse>
        <Ellipse centerX="350" centerY="100" radiusX="200" radiusY="200"
                 fill="#081f71" opacity="0.9">
            <effect><GaussianBlur radius="80"/></effect>
        </Ellipse>
        <Ellipse centerX="350" centerY="100" radiusX="150" radiusY="150"
                 fill="#071b61" opacity="0.9">
            <effect><GaussianBlur radius="80"/></effect>
        </Ellipse>
        <Ellipse centerX="1200" centerY="350" radiusX="200" radiusY="200"
                 fill="#092483" opacity="1.0">
            <effect><GaussianBlur radius="500"/></effect>
        </Ellipse>
        <Ellipse centerX="1200" centerY="350" radiusX="100" radiusY="100"
                 fill="#081f71" opacity="0.9">
            <effect><GaussianBlur radius="80"/></effect>
        </Ellipse>
        <Ellipse centerX="1200" centerY="350" radiusX="50" radiusY="50"
                 fill="#071b61" opacity="0.9">
            <effect><GaussianBlur radius="80"/></effect>
        </Ellipse>
        <Ellipse centerX="700" centerY="1000" radiusX="400" radiusY="400"
                 fill="#092483" opacity="1.0">
            <effect><GaussianBlur radius="500"/></effect>
        </Ellipse>
        <Ellipse centerX="700" centerY="1000" radiusX="300" radiusY="300"
                 fill="#081f71" opacity="0.9">
            <effect><GaussianBlur radius="80"/></effect>
        </Ellipse>
        <Ellipse centerX="700" centerY="1000" radiusX="250" radiusY="250"
                 fill="#071b61" opacity="0.9">
            <effect><GaussianBlur radius="80"/></effect>
        </Ellipse>
    </Pane>

    <BorderPane style="-fx-background-color: transparent; -fx-font-family: Roboto;">

        <top>
            <HBox alignment="CENTER_LEFT" spacing="20"
                  style="-fx-padding: 15 30 15 30; -fx-background-color: transparent;">
                <Label fx:id="labelTitulo"
                       text="Nivel 1 - Test Your Rule"
                       style="-fx-font-size: 30px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #ffffff;" />
            </HBox>
        </top>

        <center>
            <VBox alignment="CENTER" spacing="20"
                  style="-fx-padding: 10 30 30 30;">

                <!-- CARD -->
                <VBox alignment="CENTER" spacing="20"
      prefWidth="600" maxWidth="600"
      style="-fx-background-color: #f0f2ff;
             -fx-background-radius: 16;
             -fx-border-color: #c5cae9;
             -fx-border-radius: 16;
             -fx-border-width: 1.5;
             -fx-padding: 30 40 30 40;">

    <!-- Cronómetro e intentos -->
    <HBox alignment="CENTER" spacing="30">
        <Label text="⏱ Tiempo:"
               style="-fx-font-size: 16px; -fx-text-fill: #3949ab;"/>
        <Label fx:id="labelTiempo" text="0 s"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
        <Label text="Intentos:"
               style="-fx-font-size: 16px; -fx-text-fill: #3949ab;"/>
        <Label fx:id="labelIntentos" text="0"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
    </HBox>

    <Label text="Haz clic en una celda de la columna OUT para ingresar tu respuesta"
       wrapText="true"
       maxWidth="520"
       style="-fx-font-size: 13px; -fx-text-fill: #3949ab; -fx-font-style: italic;"/>

    <!-- Tabla -->
    <TableView fx:id="tablaTest"
               prefWidth="520" prefHeight="280"
               style="-fx-background-color: #7e88cd;
                      -fx-border-color: #c5cae9;
                      -fx-border-width: 2;
                      -fx-border-radius: 10;
                      -fx-background-radius: 10;">
        <columns>
            <TableColumn fx:id="colIn"  text="In"  prefWidth="259"
                         style="-fx-alignment: CENTER;
                                -fx-font-size: 16px;
                                -fx-font-weight: bold;"/>
            <TableColumn fx:id="colOut" text="Out" prefWidth="259"
                         style="-fx-alignment: CENTER;
                                -fx-font-size: 16px;
                                -fx-font-weight: bold;"/>
        </columns>
    </TableView>

    <!-- Feedback -->
    <Label fx:id="labelFeedback" text=""
           wrapText="true"
           maxWidth="520"
           style="-fx-font-size: 14px; -fx-text-fill: #e53935;"/>

    <!-- Botones -->
    <HBox alignment="CENTER" spacing="20">
        <Button text="Check my answers"
                onAction="#handleCheck"
                prefWidth="220"
                style="-fx-background-color: #3f4e85;
                       -fx-text-fill: white;
                       -fx-font-size: 16px;
                       -fx-font-weight: bold;
                       -fx-padding: 10 24 10 24;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;"/>
        <Button text="Go back and try more inputs"
                onAction="#handleGoBack"
                prefWidth="280"
                style="-fx-background-color: #c5cae9;
                       -fx-text-fill: #1a237e;
                       -fx-font-size: 16px;
                       -fx-font-weight: bold;
                       -fx-padding: 10 24 10 24;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;"/>
    </HBox>

</VBox>
            </VBox>
        </center>

    </BorderPane>

</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.Controller.BloqueDeclararRegla"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #e3f2fd; -fx-padding: 15 20 15 20;">
            <Label fx:id="labelTitulo"
                   text="Nivel 1 - Test Your Rule"
                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1565c0;" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20"
              style="-fx-padding: 30 60 30 60;">

            <!-- Cronómetro e intentos -->
            <HBox alignment="CENTER" spacing="40">
                <Label text="⏱ Tiempo:"
                       style="-fx-font-size: 14px; -fx-text-fill: #424242;"/>
                <Label fx:id="labelTiempo"
                       text="0 s"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1565c0;"/>
                <Label text="Intentos:"
                       style="-fx-font-size: 14px; -fx-text-fill: #424242;"/>
                <Label fx:id="labelIntentos"
                       text="0"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1565c0;"/>
            </HBox>

            <TableView fx:id="tablaTest"
                       prefWidth="340" prefHeight="230"
                       style="-fx-background-color: white;
                              -fx-border-color: #90caf9;
                              -fx-border-width: 2;
                              -fx-border-radius: 8;">
                <columns>
                    <TableColumn fx:id="colIn"  text="In"  prefWidth="169"
                                 style="-fx-alignment: CENTER;
                                        -fx-font-size: 15px;
                                        -fx-font-weight: bold;"/>
                    <TableColumn fx:id="colOut" text="Out" prefWidth="169"
                                 style="-fx-alignment: CENTER;
                                        -fx-font-size: 15px;
                                        -fx-font-weight: bold;"/>
                </columns>
            </TableView>

            <Label fx:id="labelFeedback"
                   text=""
                   style="-fx-font-size: 13px; -fx-text-fill: #e53935;"/>

            <!-- Botones -->
            <HBox alignment="CENTER" spacing="20">
                <Button text="Check my answers"
                        onAction="#handleCheck"
                        style="-fx-background-color: #64b5f6;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-padding: 10 24 10 24;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"/>
                <Button text="Go back and try more inputs"
                        onAction="#handleGoBack"
                        style="-fx-background-color: #e0e0e0;
                               -fx-text-fill: #424242;
                               -fx-font-size: 14px;
                               -fx-padding: 10 24 10 24;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
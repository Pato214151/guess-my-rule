<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.Controller.DeclararReglaController"
            style="-fx-background-color: #f5f5f5; -fx-font-family: Roboto;">

    <!-- HEADER -->
    <top>
        <HBox style="-fx-padding: 14; -fx-background-color: #1a237e;" alignment="CENTER_LEFT" spacing="12">
            <Button text="←"
                    onAction="#handleVolver"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 20px;
                           -fx-cursor: hand;" />
            <Label fx:id="labelNivel"
                   text="Test Your Rule!"
                   style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <!-- CONTENIDO CENTRAL -->
    <center>
        <VBox alignment="CENTER" spacing="20"
              style="-fx-padding: 30;">

            <!-- Cronómetro e intentos -->
            <HBox alignment="CENTER" spacing="40">
                <VBox alignment="CENTER" spacing="4">
                    <Label text="⏱ Tiempo"
                           style="-fx-font-size: 13px; -fx-text-fill: #555;" />
                    <Label fx:id="labelTimer"
                           text="00:00"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
                </VBox>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="🔄 Intentos fallidos"
                           style="-fx-font-size: 13px; -fx-text-fill: #555;" />
                    <Label fx:id="labelIntentos"
                           text="Intentos: 0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e53935;" />
                </VBox>
            </HBox>

            <!-- Instrucción -->
            <Label text="Ingresa la salida correcta para cada entrada:"
                   style="-fx-font-size: 15px; -fx-text-fill: #333;" />

            <!-- Preguntas generadas dinámicamente -->
            <VBox fx:id="contenedorPreguntas"
                  alignment="CENTER_LEFT"
                  spacing="8"
                  style="-fx-background-color: white;
                         -fx-padding: 20;
                         -fx-border-radius: 8;
                         -fx-background-radius: 8;
                         -fx-effect: dropshadow(gaussian, #0002, 6, 0, 0, 2);">
                <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>
            </VBox>

            <!-- Feedback -->
            <Label fx:id="labelFeedback"
                   text=""
                   style="-fx-font-size: 14px;" />

            <!-- Botón verificar -->
            <Button fx:id="btnVerificar"
                    text="✔ Verificar respuestas"
                    onAction="#handleVerificar"
                    style="-fx-background-color: #1a237e;
                           -fx-text-fill: white;
                           -fx-font-size: 15px;
                           -fx-padding: 10 28 10 28;
                           -fx-background-radius: 6;
                           -fx-cursor: hand;" />
        </VBox>
    </center>
</BorderPane>

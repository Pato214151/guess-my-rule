<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.Controller.ResultadoNivelController"
            style="-fx-background-color: #e8f5e9;">

    <center>
        <VBox alignment="CENTER" spacing="22" style="-fx-padding: 50;">

            <!-- Trofeo / ícono -->
            <Label text="🏆"
                   style="-fx-font-size: 64px;" />

            <Label fx:id="labelMensaje"
                   text=""
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1b5e20;" />

            <Label fx:id="labelPuntaje"
                   text=""
                   style="-fx-font-size: 22px; -fx-text-fill: #1a237e; -fx-font-weight: bold;" />

            <Label fx:id="labelTiempo"
                   text=""
                   style="-fx-font-size: 16px; -fx-text-fill: #555;" />

            <Label fx:id="labelEstado"
                   text=""
                   style="-fx-font-size: 14px;" />

            <!-- Botones -->
            <HBox alignment="CENTER" spacing="16" style="-fx-padding-top: 16;">
                <Button text="🏠 Menú Principal"
                        onAction="#handleMenuPrincipal"
                        style="-fx-background-color: #1a237e;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-padding: 10 22 10 22;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;" />
                <Button text="🏅 Ver Ranking"
                        onAction="#handleVerRanking"
                        style="-fx-background-color: #f57f17;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-padding: 10 22 10 22;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </center>
</BorderPane>

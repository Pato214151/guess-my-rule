<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.Controller.RankingController"
            style="-fx-background-color: #f5f5f5; -fx-font-family: Roboto;">

    <!-- HEADER -->
    <top>
        <HBox style="-fx-padding: 14; -fx-background-color: #1a237e;" alignment="CENTER_LEFT" spacing="12">
            <Button text="←"
                    onAction="#handleVolver"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 20px;
                           -fx-cursor: hand;" />
            <Label text="🏅 Ranking Global"
                   style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <!-- CONTENIDO CENTRAL -->
    <center>
        <VBox spacing="14" style="-fx-padding: 24;">

            <!-- Filtro + Actualizar -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Filtrar por nivel:"
                       style="-fx-font-size: 14px;" />
                <ComboBox fx:id="filtroNivel"
                          style="-fx-font-size: 14px;" />
                <Button text="🔄 Actualizar"
                        onAction="#handleActualizar"
                        style="-fx-background-color: #1a237e;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-padding: 7 16 7 16;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;" />
            </HBox>

            <!-- Tabla de ranking -->
            <TableView fx:id="tablaRanking"
                       style="-fx-font-size: 14px;"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colJugador"  text="Jugador"  prefWidth="160" />
                    <TableColumn fx:id="colNivel"    text="Nivel"    prefWidth="60"  />
                    <TableColumn fx:id="colPuntaje"  text="Puntaje"  prefWidth="90"  />
                    <TableColumn fx:id="colFecha"    text="Fecha"    prefWidth="150" />
                </columns>
                <placeholder>
                    <Label text="No hay puntajes aún." style="-fx-text-fill: #888;" />
                </placeholder>
            </TableView>

            <!-- Estado -->
            <Label fx:id="labelEstado"
                   text=""
                   style="-fx-font-size: 13px; -fx-text-fill: #555;" />
        </VBox>
    </center>
</BorderPane>

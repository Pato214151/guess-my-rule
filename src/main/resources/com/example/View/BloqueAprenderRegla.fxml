<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.Controller.BloqueAprenderRegla"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #e3f2fd; -fx-padding: 15 20 15 20;">
            <Button text="←"
                    onAction="#handleVolver"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #1565c0;
                           -fx-font-size: 20px;
                           -fx-underline: true;
                           -fx-cursor: hand;" />
            <Label fx:id="labelTitulo"
                   text="Nivel 1 - Adivina la Regla"
                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1565c0;" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="24"
              style="-fx-padding: 30 60 30 60;">

            <HBox alignment="CENTER" spacing="12">
                <TextField fx:id="inputNumero"
                           promptText="Ingresa Número"
                           prefWidth="120"
                           style="-fx-font-size: 16px;
                                  -fx-padding: 8;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #90caf9;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 2;" />
                <Button text="Go!"
                        onAction="#handleGo"
                        style="-fx-background-color: #64b5f6;
                               -fx-text-fill: white;
                               -fx-font-size: 15px;
                               -fx-font-weight: bold;
                               -fx-padding: 8 22 8 22;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;" />
            </HBox>

            <TableView fx:id="tablaInOut"
                       prefWidth="320" prefHeight="220"
                       style="-fx-background-color: white;
                              -fx-border-color: #90caf9;
                              -fx-border-width: 2;
                              -fx-border-radius: 8;">
                <columns>
                    <TableColumn fx:id="colIn"  text="In"  prefWidth="159"
                                 style="-fx-alignment: CENTER;
                                        -fx-font-size: 15px;
                                        -fx-font-weight: bold;" />
                    <TableColumn fx:id="colOut" text="Out" prefWidth="159"
                                 style="-fx-alignment: CENTER;
                                        -fx-font-size: 15px;
                                        -fx-font-weight: bold;" />
                </columns>
                <placeholder>
                    <Label text="Ingresa un número para comenzar"
                           style="-fx-text-fill: #9e9e9e; -fx-font-size: 13px;" />
                </placeholder>
            </TableView>

            <Label fx:id="labelFeedback"
                   text=""
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #e53935;" />

            <Button text="I think I know the rule!"
                    onAction="#handleDeclararRegla"
                    style="-fx-background-color: #bbdefb;
                           -fx-text-fill: #1565c0;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-padding: 10 28 10 28;
                           -fx-background-radius: 20;
                           -fx-cursor: hand;" />

        </VBox>
    </center>

</BorderPane>
